# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# Local SQLite default (zero-install):
DATABASE_URL="file:./dev.db"
# For PostgreSQL / Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newtonite_ops"

# Authentication
JWT_SECRET="super-secret-newtonite-operations-key-2026"
JWT_EXPIRES_IN="7d"

# Outbox Background Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=10
